# Copy to .env and fill in. .env is git-ignored; this template is not.

# Required. The agent fails to start without it.
OPENAI_API_KEY=

# k8s-manager API. Defaults to the local mock, which needs no credentials.
# Point at the real cluster by setting the URL and both credential vars:
#   K8S_MANAGER_URL=https://intend-k8s-manager.gate-ai.eu
# Note the real API is behind HTTP Basic auth at the ingress, on 443.
# Port 8000 only applies to a `kubectl port-forward`.
K8S_MANAGER_URL=http://test-api:8001
K8S_MANAGER_USERNAME=
K8S_MANAGER_PASSWORD=


# Leave empty to stay read-only. This key is required for WRITE: POST/PUT/DELETE
# /instances, PATCH /kafka/topics/config, POST /snapshots, GET /admin/whoami.
K8S_MANAGER_ADMIN_KEY=
